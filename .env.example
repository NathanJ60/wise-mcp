# Copy to .env and fill in. Never commit the real file.

# Required: Wise personal API token (Settings > Developer tools > API tokens).
WISE_API_TOKEN=

# Write scopes to enable (read is always on). Example "safe default":
# WISE_ENABLE=invoices,webhooks,recipients,quotes,balance_moves
WISE_ENABLE=

# Hard-blocked scopes. Always wins over WISE_ENABLE.
WISE_DENY=transfers,batch_transfers

# true = every write scope off, whatever WISE_ENABLE says.
WISE_READ_ONLY=false

# Optional allowlists (comma-separated ids).
# WISE_ALLOWED_PROFILE_IDS=
# WISE_ALLOWED_RECIPIENT_IDS=

# Optional caps for money movements: "500" or "EUR=500,USD=550".
# WISE_MAX_AMOUNT_PER_TX=
# WISE_MAX_AMOUNT_PER_DAY=

# Optional: SCA signing key (RSA private key, PEM) for EU/UK statements and funding.
# WISE_SCA_PRIVATE_KEY_PATH=

# Optional paths and tuning.
# WISE_AUDIT_LOG=
# WISE_DATA_DIR=
# WISE_SANDBOX=false
# WISE_TIMEOUT_SECONDS=30
# WISE_CONFIRMATION_TTL_SECONDS=300
# WISE_LOG_LEVEL=WARNING
